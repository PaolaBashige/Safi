# Lambda environment configuration. These are set on the function by infra/template.yaml.
# Never put AWS credentials in this file.

# true  = rule-based analysis only; Bedrock is never called (default, fail-safe)
# false = call Amazon Bedrock (only after the account can invoke models)
MOCK_AI=true

# AWS_REGION is provided automatically by Lambda (us-east-1). Set it only for local runs.
AWS_REGION=us-east-1

# Nova 2 Lite must be called through an inference profile.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
