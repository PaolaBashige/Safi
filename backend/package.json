{
  "name": "safi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Safi analysis Lambda: deterministic security checks + Bedrock adapter + strict output validation",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --external:@aws-sdk/* --minify --outfile=dist/index.js",
    "package": "npm run build && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
